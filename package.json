{
  "name": "@archnemix/image-protection",
  "version": "1.30.4",
  "description": "Archnemix (Archx) — layered image protection for websites. Keep original files off public routes and deliver authorized derivatives through a guarded canvas viewer with scrambled/encrypted transport, one-time tokens, and attribution marks.",
  "license": "0BSD",
  "author": "Archnemix",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archnemix/Archnemix_Image_Protection.git"
  },
  "homepage": "https://github.com/archnemix/Archnemix_Image_Protection#readme",
  "bugs": {
    "url": "https://github.com/archnemix/Archnemix_Image_Protection/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/archx.cjs",
  "module": "./dist/archx.esm.js",
  "unpkg": "./dist/archx.min.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/archx.esm.js",
      "require": "./dist/archx.cjs",
      "default": "./dist/archx.esm.js"
    },
    "./server": {
      "types": "./types/server.d.ts",
      "default": "./server/middleware.js"
    },
    "./server/scramble-image": {
      "types": "./types/server.d.ts",
      "default": "./server/scramble-image.js"
    },
    "./build": {
      "types": "./types/build.d.ts",
      "default": "./server/build-assets.js"
    },
    "./redis": {
      "types": "./types/redis.d.ts",
      "default": "./server/redis-state-store.js"
    },
    "./scramble": {
      "types": "./types/scramble.d.ts",
      "default": "./src/scramble.js"
    }
  },
  "files": [
    "dist/archx.cjs",
    "dist/archx.esm.js",
    "dist/archx.min.js",
    "dist/archx.min.js.sri",
    "src/archx.js",
    "src/browser-global.js",
    "src/index.js",
    "src/core/bytes.js",
    "src/core/crypto.js",
    "src/core/plan.js",
    "src/core/sniff.js",
    "src/core/container.js",
    "src/core/forensic.js",
    "src/core/bch.js",
    "src/core/stego-code.js",
    "src/core/pixels.js",
    "src/core/stego-embed.js",
    "src/core/stego-detect.js",
    "src/core/stego-deskew.js",
    "src/core/stego-assay.js",
    "src/core/perceptual.js",
    "src/scramble.js",
    "server/middleware.js",
    "server/seo-preview.js",
    "server/signing-keyring.js",
    "server/request-identity.js",
    "server/node-crypto.js",
    "server/issuance-log.js",
    "server/ownership.js",
    "server/build-assets.js",
    "server/build-assets-cli.js",
    "server/redis-state-store.js",
    "server/scramble-image.js",
    "server/detect-worker.js",
    "server/scramble-cli.js",
    "server/detect-stego-cli.js",
    "CHANGELOG.md",
    "README.md",
    "docs/*.md",
    "!docs/REQUIREMENTS_TRACKER.md",
    "!docs/RELEASE_STATUS.md",
    "examples/archx-showcase.html",
    "examples/chunked-transport/client.js",
    "examples/chunked-transport/server.mjs",
    "examples/chunked-transport/README.md",
    "LICENSE",
    "SECURITY.md",
    "types/*.d.ts",
    "src/client/",
    "server/bounded.js",
    "server/tokens.js",
    "server/config.js",
    "server/ops.js"
  ],
  "bin": {
    "archx-protect": "server/scramble-cli.js",
    "archx-build": "server/build-assets-cli.js",
    "archx-detect": "server/detect-stego-cli.js"
  },
  "scripts": {
    "build": "node tools/build.mjs && node tools/generate-types.mjs",
    "build:debug": "node tools/build.mjs --debug",
    "prepack": "npm run build && node tools/package-artifact.mjs sanitize",
    "postpack": "node tools/package-artifact.mjs restore",
    "demo": "node server/demo-server.js",
    "demo:images": "node tools/generate-test-images.mjs",
    "test": "node --test tests/unit.test.mjs tests/fuzz.test.mjs",
    "test:fuzz": "node --test tests/fuzz.test.mjs",
    "test:browser": "node tests/browser-test.mjs",
    "test:all": "npm run build && npm test && npm run test:browser",
    "bench": "node tools/benchmark.mjs",
    "bench:opt": "node --expose-gc tools/optimization-bench.mjs",
    "load-test": "node tools/load-test.mjs",
    "docs:check": "node tools/docs-check.mjs",
    "size:browser": "node tools/bundle-size.mjs",
    "lint": "node tools/lint.mjs",
    "verify": "npm run lint && npm run build && npm run types:check && npm run test:types && npm run docs:check && npm test && npm run test:browser && npm audit --audit-level=high",
    "types:generate": "node tools/generate-types.mjs",
    "types:check": "node tools/generate-types.mjs --check",
    "test:types": "tsc --noEmit -p tsconfig.json",
    "test:pack": "node tools/pack-smoke.mjs",
    "test:redis": "node --test tests/redis-integration.test.mjs",
    "test:redis:local": "node tools/test-redis-local.mjs",
    "bench:stego:evidence": "node tools/stego-evidence.mjs",
    "bench:stego": "node tools/stego-bench.mjs",
    "calibrate:perceptual": "node tools/calibrate-perceptual.mjs",
    "key:rotation-plan": "node tools/signing-key-rotation.mjs",
    "redteam": "node tools/red-team.mjs",
    "redteam:v2": "node tools/red-team-v2.mjs"
  },
  "keywords": [
    "image-protection",
    "anti-scraping",
    "canvas",
    "watermark",
    "forensic-watermarking",
    "copyright",
    "webgl",
    "steganography",
    "signed-urls",
    "temporal-interlace"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^138.0.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "fflate": "0.8.3",
    "ioredis": "^6.0.0",
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "sharp": "^0.35.5"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "types": "./types/index.d.ts"
}
