{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "types-src",
    "outDir": ".types-generated"
  },
  "include": ["types-src/**/*.ts"]
}
